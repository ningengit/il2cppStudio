<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0-android</TargetFramework>
    <SupportedOSPlatformVersion>24.0</SupportedOSPlatformVersion>
    <RuntimeIdentifier>android-arm64</RuntimeIdentifier>
    <RuntimeIdentifiers>android-arm64</RuntimeIdentifiers>
    <RootNamespace>Il2CppStudio.Android</RootNamespace>
    <AssemblyName>Il2CppStudio.Android</AssemblyName>
    <ApplicationId>com.il2cppstudio.app</ApplicationId>
    <ApplicationVersion>20400</ApplicationVersion>
    <ApplicationDisplayVersion>2.4.0</ApplicationDisplayVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <PropertyGroup>
    <AndroidSdkDirectory Condition="'$(AndroidSdkDirectory)' == '' and '$(ANDROID_HOME)' != '' and Exists('$(ANDROID_HOME)')">$(ANDROID_HOME)</AndroidSdkDirectory>
    <AndroidSdkDirectory Condition="'$(AndroidSdkDirectory)' == '' and '$(LOCALAPPDATA)' != '' and Exists('$(LOCALAPPDATA)\Android\Sdk')">$(LOCALAPPDATA)\Android\Sdk</AndroidSdkDirectory>

    <_JavaHomeBin Condition="'$(JAVA_HOME)' != ''">$([MSBuild]::EnsureTrailingSlash('$(JAVA_HOME)'))bin\java.exe</_JavaHomeBin>
    <_JavaHomeReleaseFile Condition="'$(JAVA_HOME)' != '' and '$(_JavaHomeBin)' != '' and Exists('$(_JavaHomeBin)')">$([MSBuild]::EnsureTrailingSlash('$(JAVA_HOME)'))release</_JavaHomeReleaseFile>
    <_JavaHomeMajor Condition="'$(JavaSdkDirectory)' == '' and '$(_JavaHomeReleaseFile)' != '' and Exists('$(_JavaHomeReleaseFile)')">$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(_JavaHomeReleaseFile)')), '(?&lt;=JAVA_VERSION=&quot;)\d+').Value)</_JavaHomeMajor>
    <_JavaHomeIsModern>false</_JavaHomeIsModern>
    <_JavaHomeIsModern Condition="'$(_JavaHomeMajor)' != ''">$([MSBuild]::VersionGreaterThanOrEquals('$(_JavaHomeMajor).0', '21.0'))</_JavaHomeIsModern>
    <JavaSdkDirectory Condition="'$(JavaSdkDirectory)' == '' and '$(_JavaHomeIsModern)' == 'True'">$(JAVA_HOME)</JavaSdkDirectory>
    <JavaSdkDirectory Condition="'$(JavaSdkDirectory)' == '' and Exists('C:\Program Files\Android\Android Studio\jbr\bin\java.exe')">C:\Program Files\Android\Android Studio\jbr</JavaSdkDirectory>
    <JavaSdkDirectory Condition="'$(JavaSdkDirectory)' == '' and Exists('C:\Program Files\Android\AndroidStudioLatest\jbr\bin\java.exe')">C:\Program Files\Android\AndroidStudioLatest\jbr</JavaSdkDirectory>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Il2CppStudio.Ui\Il2CppStudio.Ui.csproj" />
    <PackageReference Include="Avalonia.Android" />
  </ItemGroup>

  <!-- Syntax highlighting uses DarkPlusSyntaxHighlighter on Android; preserve AvaloniaEdit for reflection-based XAML/control instantiation. -->
  <ItemGroup>
    <TrimmerRootAssembly Include="AvaloniaEdit" />
  </ItemGroup>

  <!-- Clear cached prelink/linked/R2R assemblies whenever NuGet packages change so older-timestamped upgraded DLLs (e.g. SkiaSharp 3.119.4) are never skipped by incremental MSBuild copy checks. -->
  <Target Name="CleanStaleAndroidLinkCachesOnAssetsChange"
          BeforeTargets="BeforeBuild"
          Inputs="$(ProjectAssetsFile)"
          Outputs="$(IntermediateOutputPath)prelink-assets.stamp"
          Condition="'$(ProjectAssetsFile)' != '' and Exists('$(ProjectAssetsFile)')">
    <RemoveDir Directories="$(IntermediateOutputPath)prelink;$(IntermediateOutputPath)linked;$(IntermediateOutputPath)R2R;$(IntermediateOutputPath)afterlink" />
    <WriteLinesToFile File="$(IntermediateOutputPath)prelink-assets.stamp" Lines="synced" Overwrite="true" />
  </Target>

  <Target Name="CopyReleaseApkToDist"
          AfterTargets="Build"
          Condition="'$(Configuration)' == 'Release' and '$(BuildingInsideVisualStudio)' != 'true' and Exists('$(ApkFileSigned)')">
    <PropertyGroup>
      <_DistAndroidDir>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\..\dist\android-arm64'))</_DistAndroidDir>
      <_ApkSignedDest>$([System.IO.Path]::Combine('$(_DistAndroidDir)', '$([System.IO.Path]::GetFileName('$(ApkFileSigned)'))'))</_ApkSignedDest>
      <_ApkUnsignedDest Condition="'$(ApkFile)' != '' and Exists('$(ApkFile)')">$([System.IO.Path]::Combine('$(_DistAndroidDir)', '$([System.IO.Path]::GetFileName('$(ApkFile)'))'))</_ApkUnsignedDest>
    </PropertyGroup>
    <MakeDir Directories="$(_DistAndroidDir)" />
    <Copy SourceFiles="$(ApkFileSigned)"
          DestinationFiles="$(_ApkSignedDest)"
          SkipUnchangedFiles="false"
          Condition="$([System.String]::Compare('$([System.IO.Path]::GetFullPath('$(ApkFileSigned)'))', '$(_ApkSignedDest)', true)) != 0" />
    <Copy SourceFiles="$(ApkFile)"
          DestinationFiles="$(_ApkUnsignedDest)"
          SkipUnchangedFiles="false"
          Condition="'$(_ApkUnsignedDest)' != '' and $([System.String]::Compare('$([System.IO.Path]::GetFullPath('$(ApkFile)'))', '$(_ApkUnsignedDest)', true)) != 0" />
    <Message Importance="high" Text="APK packaged to $(_ApkSignedDest)" />
  </Target>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Il2CppStudio.Core</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Il2CppStudio.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AsmResolver.PE" />
    <PackageReference Include="AsmResolver.PE.File" />
    <PackageReference Include="AsmResolver.DotNet" />
    <PackageReference Include="AsmArm64" />
    <PackageReference Include="Iced" />
    <PackageReference Include="ICSharpCode.Decompiler" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Serilog.Formatting.Compact" />
  </ItemGroup>

  <!-- Vendored/built-in disassemblers (sources + licenses under src/vendor): WebAssembly, pure-C# ARMv7/Thumb-2. -->
  <ItemGroup>
    <ProjectReference Include="..\vendor\WasmDisassembler\WasmDisassembler.csproj" />
  </ItemGroup>

</Project>

<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Il2CppStudio.Gui.ViewModels"
        x:Class="Il2CppStudio.Gui.Views.BootConfigWindow"
        x:DataType="vm:BootConfigViewModel"
        Title="Configure Diagnostic Boot Flags" Width="640" Height="380" WindowStartupLocation="CenterOwner" CanResize="False">
  <DockPanel Margin="16">
    <TextBlock DockPanel.Dock="Top" Text="{Binding FilePath}" Foreground="Gray" Margin="0,0,0,12" TextTrimming="CharacterEllipsis" />
    <StackPanel DockPanel.Dock="Bottom" Spacing="8">
      <TextBlock Text="{Binding Status}" Foreground="#4EC9B0" TextWrapping="Wrap" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
        <Button Content="Restore Backup" Command="{Binding RestoreCommand}" />
        <Button Content="Apply" Command="{Binding ApplyCommand}" Classes="accent" />
        <Button Content="Close" Command="{Binding CloseCommand}" />
      </StackPanel>
    </StackPanel>
    <ItemsControl ItemsSource="{Binding Entries}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:BootConfigEntry">
          <Grid ColumnDefinitions="30,260,*,140" Margin="0,4">
            <CheckBox Grid.Column="0" IsChecked="{Binding Enabled}" />
            <TextBlock Grid.Column="1" Text="{Binding Key}" VerticalAlignment="Center" />
            <TextBox Grid.Column="2" Text="{Binding Value}" />
            <TextBlock Grid.Column="3" Text="{Binding Current, StringFormat='current: {0}', TargetNullValue='current: (unset)'}"
                       Foreground="Gray" VerticalAlignment="Center" Margin="8,0,0,0" />
          </Grid>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </DockPanel>
</Window>

<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Il2CppStudio.Gui.ViewModels"
        xmlns:views="using:Il2CppStudio.Gui.Views"
        x:Class="Il2CppStudio.Gui.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="{Binding Title}" Width="1400" Height="860" MinWidth="800" MinHeight="500"
        WindowStartupLocation="CenterScreen" SystemDecorations="Full" CanResize="True"
        ExtendClientAreaToDecorationsHint="False"
        DragDrop.AllowDrop="True">
  <Grid>
    <views:MainView />

    <Border x:Name="DropOverlay"
            IsVisible="False"
            IsHitTestVisible="False"
            Background="#B0111622"
            BorderBrush="#4FA6FF"
            BorderThickness="2"
            CornerRadius="8"
            Margin="12">
      <TextBlock Text="Drop a game folder, APK, XAPK, APKS, APKM, IPA, NSP, PKG, PRX, WASM, Mach-O, or global-metadata.dat to load"
                 IsHitTestVisible="False"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 FontSize="16"
                 FontWeight="SemiBold"
                 Foreground="#E8F1FF" />
    </Border>
  </Grid>
</Window>

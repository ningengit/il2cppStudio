<Project>
  <!-- Il2CppStudio.Core is RID-agnostic, so Microsoft.NET.Sdk strips RuntimeIdentifier when evaluating its
       GetCopyToOutputDirectoryItems/GetCopyToPublishDirectoryItems. Strip the Windows x64 capstone.dll on
       consumers targeting any other RID or building RID-less on non-Windows hosts. -->
  <Target Name="FilterWindowsX64Capstone"
          AfterTargets="GetCopyToOutputDirectoryItems"
          BeforeTargets="_CopyOutOfDateSourceItemsToOutputDirectory;_CopySourceItemsToOutputDirectory"
          Condition="('$(RuntimeIdentifier)' != '' and '$(RuntimeIdentifier)' != 'win-x64') or ('$(RuntimeIdentifier)' == '' and !$([MSBuild]::IsOSPlatform('Windows')))">
    <ItemGroup>
      <_SourceItemsToCopyToOutputDirectory Remove="@(_SourceItemsToCopyToOutputDirectory)" Condition="'%(_SourceItemsToCopyToOutputDirectory.Filename)%(_SourceItemsToCopyToOutputDirectory.Extension)' == 'capstone.dll'" />
      <_SourceItemsToCopyToOutputDirectoryAlways Remove="@(_SourceItemsToCopyToOutputDirectoryAlways)" Condition="'%(_SourceItemsToCopyToOutputDirectoryAlways.Filename)%(_SourceItemsToCopyToOutputDirectoryAlways.Extension)' == 'capstone.dll'" />
      <AllItemsFullPathWithTargetPath Remove="@(AllItemsFullPathWithTargetPath)" Condition="'%(AllItemsFullPathWithTargetPath.Filename)%(AllItemsFullPathWithTargetPath.Extension)' == 'capstone.dll'" />
    </ItemGroup>
  </Target>

  <Target Name="FilterWindowsX64CapstonePublish"
          AfterTargets="ComputeResolvedFilesToPublishList"
          BeforeTargets="CopyFilesToPublishDirectory"
          Condition="('$(RuntimeIdentifier)' != '' and '$(RuntimeIdentifier)' != 'win-x64') or ('$(RuntimeIdentifier)' == '' and !$([MSBuild]::IsOSPlatform('Windows')))">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(ResolvedFileToPublish.Filename)%(ResolvedFileToPublish.Extension)' == 'capstone.dll'" />
    </ItemGroup>
  </Target>
</Project>
